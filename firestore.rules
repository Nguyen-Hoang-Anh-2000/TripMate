rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // 2. Trips collection
    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid && isValidId(tripId);
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        (incoming().memberUids != null && request.auth.uid in incoming().memberUids)
      );
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // 3. Invitations collection
    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid ||
        (resource.data.inviteeUid != null && resource.data.inviteeUid == request.auth.uid) ||
        (resource.data.inviteeEmail != null && request.auth.token.email != null && resource.data.inviteeEmail == request.auth.token.email)
      );
      allow create: if isSignedIn() && incoming().inviterId == request.auth.uid && isValidId(invitationId);
      allow update: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid ||
        (resource.data.inviteeUid != null && resource.data.inviteeUid == request.auth.uid) ||
        (resource.data.inviteeEmail != null && request.auth.token.email != null && resource.data.inviteeEmail == request.auth.token.email)
      );
      allow delete: if isSignedIn() && resource.data.inviterId == request.auth.uid;
    }
  }
}
