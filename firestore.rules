rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users collection
    function isValidUser(data) {
      return data.displayName is string 
        && data.displayName.size() > 0 
        && data.displayName.size() <= 150
        && data.email is string 
        && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 60000))
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128));
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming()) && (incoming().id == existing().id) && (incoming().email == existing().email);
      allow delete: if false;
    }

    // 2. Trips collection
    function isValidTrip(data) {
      return data.title is string 
        && data.title.size() > 0 
        && data.title.size() <= 200
        && data.destination is string 
        && data.destination.size() <= 200
        && data.creatorId is string 
        && data.creatorId.size() <= 128
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10));
    }

    match /trips/{tripId} {
      allow get: if isValidId(tripId);
      allow list: if true;
      allow create: if isValidId(tripId) && isValidTrip(incoming());
      // R4(c): creatorId is strictly immutable on update
      allow update: if isValidId(tripId) 
        && isValidTrip(incoming()) 
        && incoming().creatorId == existing().creatorId;
      allow delete: if isValidId(tripId);
    }

    // 3. Invitations collection
    function isValidInvitation(data) {
      return data.tripId is string 
        && data.tripId.size() <= 128
        && data.inviterId is string 
        && data.inviterId.size() <= 128
        && data.status in ['pending', 'accepted', 'declined']
        && (!('tripTitle' in data) || (data.tripTitle is string && data.tripTitle.size() <= 200))
        && (!('tripDestination' in data) || (data.tripDestination is string && data.tripDestination.size() <= 200));
    }

    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId);
      allow list: if true;
      allow create: if isValidId(invitationId) && isValidInvitation(incoming());
      // R4(d): updates can only modify status and respondedAt, preventing tampering with tripId/inviterId
      allow update: if isValidId(invitationId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'respondedAt'])
        && incoming().status in ['accepted', 'declined'];
      allow delete: if isValidId(invitationId);
    }

    // 4. Persistent User Notifications (Trip Deletion & Expense Settlement Notices)
    function isValidUserNotification(data) {
      return data.type in ['trip_deleted', 'trip_deleted_settlement', 'info']
        && data.tripId is string && data.tripId.size() > 0 && data.tripId.size() <= 128
        && data.tripTitle is string && data.tripTitle.size() > 0 && data.tripTitle.size() <= 200
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.actorId is string && data.actorId.size() <= 128
        && data.actorName is string && data.actorName.size() <= 150
        && data.status in ['unread', 'read']
        && (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128))
        && (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 200))
        && (!('targetPhone' in data) || (data.targetPhone is string && data.targetPhone.size() <= 30))
        && (!('targetMemberName' in data) || (data.targetMemberName is string && data.targetMemberName.size() <= 150))
        && (!('fromMemberName' in data) || (data.fromMemberName is string && data.fromMemberName.size() <= 150))
        && (!('toMemberName' in data) || (data.toMemberName is string && data.toMemberName.size() <= 150))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('amount' in data) || (data.amount is number));
    }

    match /user_notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow create: if isValidId(notificationId) && isValidUserNotification(incoming());
      allow update: if isValidId(notificationId)
        && isValidUserNotification(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'readAt'])
        && incoming().status == 'read';
      allow delete: if isValidId(notificationId);
    }
  }
}
